                        <!-- Arrow 1 -->
                        <path d="M 150 100 L 180 100" stroke="#2E7D32" stroke-width="2" marker-end="url(#arrowhead)"/>
                        
                        <!-- Stage 2: Hard Filter -->
                        <rect x="200" y="60" width="120" height="80" fill="#F5F7FA" stroke="#2E7D32" stroke-width="2" rx="8"/>
                        <text x="260" y="105" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="600" fill="#2E7D32">Hard Filter</text>
