                <h2>Dataset Schema</h2>
                <p>Each curated entry in the dataset follows this structure:</p>
                
                <div class="schema-box">
{
  "id": "agri_001",
  "category": "crop_management",
  "query": "What is the optimal planting depth for corn in clay soil?",
  "source_doc_ids": ["doc_123", "doc_456", "doc_789"],
  "provenance": {
    "seed_generation": "LLM",
    "embedding_model": "Qwen3-Embedding-8B",
    "retrieval_top_k": 5,
    "reviewed_by": "expert_001"
  },
  "notes": "Common question from extension bulletins"
}
                </div>
            <div class="hero-resource-buttons">
